{
  "name": "tagquest-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "compile:maps": "python3 ../compiler/build.py",
    "predev": "npm run compile:maps",
    "prebuild": "npm run compile:maps",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "verify:editor": "node scripts/verify-editor.mjs",
    "verify:interactions": "node scripts/verify-interactions.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "verify:world": "node scripts/verify-world.mjs",
    "verify:walls": "node scripts/verify-walls.mjs",
    "export:walls": "node scripts/export-wall-preview.mjs",
    "verify:encounters": "node scripts/verify-encounters.mjs",
    "verify:battle": "node scripts/verify-battle.mjs",
    "verify:economy": "node scripts/verify-economy.mjs",
    "verify:exchanges": "node scripts/verify-exchanges.mjs",
    "verify:progression": "node scripts/verify-progression.mjs",
    "export:enemy-pixels": "node scripts/export-enemy-pixels.mjs",
    "export:king-pixels": "node scripts/export-king-pixels.mjs",
    "export:forest-pixels": "node scripts/export-forest-pixels.mjs",
    "export:world-pixels": "node scripts/export-world-pixels.mjs",
    "export:adventure": "node scripts/export-adventure.mjs",
    "export:demos": "node scripts/export-adventure.mjs --all",
    "verify:demos": "node scripts/verify-demos.mjs",
    "verify:story": "node scripts/verify-story.mjs",
    "export:cave-pixels": "node scripts/export-cave-pixels.mjs",
    "verify:cave": "node scripts/verify-cave.mjs",
    "export:demon-castle-pixels": "node scripts/export-demon-castle-pixels.mjs",
    "export:adventure-materials": "node scripts/export-adventure-materials.mjs",
    "export:demon-lord": "node scripts/export-demon-lord.mjs",
    "verify:audit": "node scripts/verify-audit.mjs",
    "verify:ux": "node scripts/verify-ux.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:nfc": "node scripts/verify-nfc.mjs",
    "verify:buildings": "node scripts/verify-buildings.mjs",
    "verify:adventure": "node scripts/verify-adventure.mjs",
    "verify:routing": "node scripts/verify-routing.mjs",
    "verify:font": "python3 scripts/export-font.py --check",
    "export:font": "python3 scripts/export-font.py",
    "verify:gameplay": "node scripts/verify-gameplay.mjs",
    "verify:magic": "node scripts/verify-magic.mjs",
    "verify:postgame": "node scripts/verify-postgame.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "daisyui": "5.7.47",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
